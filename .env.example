# Optional. PostPilot reads these on first start and moves the secrets into
# Windows Credential Manager. Everything can also be entered in Settings.
# (If this folder sits next to the old CLI's .env, that file is picked up automatically.)

# Your LinkedIn developer app (Settings > LinkedIn account > Advanced)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8080/callback

# Public release: use the hosted login server instead of shipping the secret
# POSTPILOT_BROKER_URL=https://login.yourdomain.com

# AI drafting (groq | openai | anthropic)
LLM_PROVIDER=groq
GROQ_API_KEY=
